# Paste your Neon connection string here (from neon.tech dashboard)
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string for signing admin login sessions
JWT_SECRET="change-this-to-a-long-random-string"

# Comma-separated list of frontend origins allowed to call this API with
# credentials (CORS). Include every domain the frontend is actually served
# from — old and new — during a migration, e.g.:
# "https://thegrandpalace.com.au,https://www.thegrandpalace.com.au,https://<siteground-domain>"
FRONTEND_URL="http://localhost:3000"

PORT=4000

# "production" on any real deploy (SiteGround included) — leave unset for local dev.
NODE_ENV=production

# Used once by `npm run seed` to create the first admin login
ADMIN_EMAIL="admin@thegrandpalace.com.au"
ADMIN_PASSWORD="changeme123"

# Admin-uploaded images (gallery, menu items, guides) are saved to local disk
# under backend/uploads/, served statically at /uploads/<file>. Set PUBLIC_URL
# to this backend's own public URL so saved image URLs are absolute (matches
# the old Vercel Blob URLs' behavior) — leave unset for local dev to store
# relative "/uploads/..." paths instead.
PUBLIC_URL="https://your-siteground-backend-domain.example.com"

# Stripe — payment processing. Live/test secret key + the webhook signing
# secret for whichever Stripe webhook endpoint is configured to point at
# this deployment's /api/stripe/webhook.
STRIPE_SECRET_KEY="sk_live_or_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# SMTP — outgoing email (enquiry/booking notifications, admin mail-test route).
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user@example.com"
SMTP_PASS="change-this"
MAIL_FROM_NAME="The Grand Palace"

# Where new booking/enquiry notification emails are sent.
BOOKINGS_EMAIL="bookings@thegrandpalace.com.au"
