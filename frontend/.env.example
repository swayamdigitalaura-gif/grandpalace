# Absolute backend URL, used by server-side route loaders (menu, gallery,
# guides, whats-on, sitemap, etc.) — these run in the Node server, where
# fetch() has no implicit origin, so this must always be an absolute URL.
# Resolved at RUNTIME (not just build time), so this can be set/changed on
# a self-hosted deploy (e.g. SiteGround) without rebuilding.
VITE_API_URL=http://localhost:4000

# Same backend URL, used to configure the /api/** reverse proxy (see
# vite.config.ts routeRules) that the BROWSER calls through — this is what
# keeps the auth cookie first-party instead of cross-domain. Keep this and
# VITE_API_URL pointing at the same backend.
# Build-time only (baked into the Nitro server at build), unlike
# VITE_API_URL above — a self-hosted deploy needs a fresh build after
# changing this.
BACKEND_URL=http://localhost:4000

# Nitro server output format. Leave unset (defaults to "vercel") for the
# current Vercel deployment. Set to "node-server" for a self-hosted Node
# deploy (e.g. SiteGround) — produces a plain server at dist/server/index.mjs,
# started with `npm start` (node ./dist/server/index.mjs).
NITRO_PRESET=vercel
