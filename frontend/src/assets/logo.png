/* .links_moves li:hover {
    color: #efaa49;
    transition: all .3s linear;
    padding-left: 7px;
    background: transparent !important;
} */
.links_moves li a {
    color: #333 !important;
}
.links_moves li {
    padding-bottom: 10px;
}
.links_moves a {
    color: #333 !important;
}
.links_moves a:hover {
    color: #efaa49 !important;
    transition: all .3s linear;
    padding-left: 7px;
    background: transparent !important;
}
.main_menu_section i {
    display: none;
	opacity: 0;
  transition: opacity 0.3s ease-in-out;
}
.main_menu_section:hover i {
    display: block;
	  opacity: 1;
  animation: fadeIn 0.3s ease-in-out;
}
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px); /* Add a slight slide-in effect */
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
a{
	text-decoration:none !important;
}
.add_shape {
    position: relative !important;
}
.add_shape:after {
    content: "";
    display: block;
    background: url(https://www.thegrandpalace.com.au/wp-content/uploads/2025/04/menu-black-curve.png) no-repeat 50%;
    width: 200px;
    height: 86px;
    position: absolute;
    top: -5px;
    background-size: cover;
    bottom: auto;
    transform: translateY(86%);
    transition: all .5s;
    left: 50%;
    margin-left: calc(-200px / 2);
    z-index: -1;
}
.wpcf7-file {
    padding-top: 4px;
}
.fixed_position {
    position: sticky !important;
    top: -50%;
    height: 600px;
	transition: all 0.5s ease-in-out;
}
.single-guides .page-content {
    padding-top: 120px;
}
.testimonials_section p{
text-align: justify !important;
}
.popup_form {
    display: block;
}
.popup_form input {
    margin-bottom: 10px;
}
.popup_form input {
    margin-bottom: 10px;
    border-right: 1px solid #000 !important;
}
.for_beverage {
    position: sticky !important;
    top: 20%;
    height: 900px;
    transition: all 0.5s ease-in-out;
}
.for_menus {
    position: sticky !important;
    top: 20%;
    height: 880px;
    transition: all 0.5s ease-in-out;
}
.for_glass {
    position: relative;
    display: inline-block;
		overflow:hidden;
    width: 30px;
    height: 30px;
}
.for_glass:before {
    content: '';
    position: absolute;
    left: 0;
    background-image: url('https://www.thegrandpalace.com.au/wp-content/uploads/2025/05/Glass.png');
    width: 30px;
    height: 30px;
    background-repeat: no-repeat;
    background-size: cover;
}
.for_bottel {
    position: relative;
    display: inline-block;
	overflow:hidden;
    width: 30px;
    height: 30px;
}
.for_bottel:before {
    content: '';
    position: absolute;
    left: 0;
    background-image: url('https://www.thegrandpalace.com.au/wp-content/uploads/2025/05/Bottel.png');
    width: 30px;
    height: 30px;
    background-repeat: no-repeat;
    background-size: cover;
}
.main_section .remove_space {
    display: flex;
    align-items: center;
}
.evnt_popup_form label {
    font-size: 14px;
    font-weight: 600;
    color: #000;
}
.evnt_popup_form input,
.evnt_popup_form textarea{
    height: 50px;
}
.evnt_popup_form .submit_btn_ {
    background-color: #000;
    border: 0;
    padding: 10px 40px 10px 40px;
    border-radius: 50px;
    color: #fff !important;
}
.birthday-btn{
	    background-color: #000;
    border: 0;
    padding: 10px 40px 10px 40px;
    border-radius: 50px;
    color: #fff !important;
}
.birthday-btn:hover{
	    background-color: #000 !important;
    color: #fff !important;
}
/* new css */
.yellow_color{
	color:#EEA33E !important;
}
.multi-step-bar{
	background-image:unset !important;
	background-color:transparent !important;
}
.on_hover_border:hover .left_border {
    border-left: 4px solid #C9954D;
}
.on_hover_border:hover:first-child .left_border {
    border-radius:12px 0 0 0;
}
.on_hover_border:hover:last-child .left_border {
    border-radius:0px 0 0 12px;
}
.left_border {
    position: relative !important;
}
.left_border:after {
    content: '';
    position: absolute;
    right: 0;
    width: 1px;
    height: 50px;
    background-color: #D6C9B4;
    top: 50%;
    transform: translateY(-50%);
}
.page-id-3985 .multi-step-bar li {
    color: #ffffff4d;
    text-transform: uppercase;
    font-size: 10px;
    font-weight: 700;
}
.page-id-3985  .multi-step-bar li:before {
    content: counter(step);
    counter-increment: step;
    width: 40px;
    line-height: 40px;
    height: 40px;
    font-size: 14px;
    color: #fff;
    background: #ffffff0f;
    border: 1px solid #ffffff26;
}
.page-id-3985 .multi-step-bar li:after {
    content: '';
    background: #ffffff1a;
}
.page-id-3985 .platter-container h2,
.page-id-3985 .platter-container h3 {
    font-weight: 600;
    color: #fff;
}
.page-id-3985 .cake-option h5,
.page-id-3985 .cake-option p,
.page-id-3985 .order-review{
    color: #fff !important;
}
.page-id-3985 #step1-form label {
    color: #fff;
}
.page-id-3985 #next-step-btn,
.page-id-3985 .back-button,
.page-id-3985 #checkout-button{
    background-color: #e19b3e;
}
.add_marker .elementor-element-populated {
    position: relative;
}
.add_marker .elementor-element-populated:before {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    background-color: #C9954A;
    border-radius: 50%;
    left: 10px;
    z-index: 1;
    top: 20px;
}
@media only screen and (max-width: 1025px) {
.add_shape:after {
    content: "";
    top: -20px;
}
}
@media only screen and (max-width: 925px) {
.add_shape:after {
    content: "";
    top: -55px;
}
}
@media only screen and (max-width: 767px) {
.add_shape img {
    width: 35% !important;
}
		.add_shape:after {
display:none;
}
	.single-guides .page-content {
    padding-top: 20px;
}
	.fixed_position{
		position:unset !important;
	}
	.for_beverage,
	.for_menus{
		position:unset !important;
	}
		.left_border:after {
    content: '';
    position: absolute;
    width: 80%;
    height: auto;
    background-color: unset;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    border-bottom: 1px solid #D6C9B4;
}
}
@media only screen and (max-width: 576px) {
.add_shape img {
    width: 50% !important;
}
	.add_shape img {
    margin-left: 50px !important;
    width: 50% !important;
}
	.filters-div{
		width:auto !important;
	}
}
@media only screen and (max-width: 420px) {
.add_shape img {
    width: 50% !important;
}
	.add_shape img {
    margin-left: 40px !important;
    width: 50% !important;
}
	.simplefilter li, .sortandshuffle li {
    padding: 4px 15px !important;
}
}
@media only screen and (max-width: 325px) {
.recaptcha:nth-child(1) div {
    margin-left: -6px !important;
}
}

</style>
</head>

