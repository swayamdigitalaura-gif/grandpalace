<script>
jQuery(function($) {
  function addCF7Error($input, message) {
    $input.addClass("wpcf7-not-valid");
    var $tip = $input.siblings(".wpcf7-not-valid-tip");
    if (!$tip.length) {
      $tip = $('<span class="wpcf7-not-valid-tip" role="alert"></span>');
      $input.after($tip);
    }
    $tip.text(message).show();
  }
  
  function removeCF7Error($input) {
    $input.removeClass("wpcf7-not-valid");
    $input.siblings(".wpcf7-not-valid-tip").hide().text("");
  }
  
  function validateVenueForm($form) {
    let isValid = true;
    // ✅ FIXED: Only target the specific date-259 field
    const $dateField = $form.find("input[name='date-259']");
    
    // --- DATE VALIDATION ---
    if ($dateField.length) {
      if ($dateField.val()) {
        let d = new Date($dateField.val());
        let day = d.getDay();
        if (day !== 0 && day !== 6) {
          addCF7Error($dateField, "Please select Saturday or Sunday only.");
          isValid = false;
        } else {
          removeCF7Error($dateField);
        }
      } else {
        addCF7Error($dateField, "Please select a date.");
        isValid = false;
      }
    }
    
    return isValid;
  }
  
  // ✅ FIXED: Only validate on the specific date-259 field
  $(document).on("change blur", ".venue_for_hire input[name='date-259']", function() {
    const $form = $(this).closest(".wpcf7-form");
    validateVenueForm($form);
  });
  
  // ✅ Multiple event listeners to ensure form blocking
  // Method 1: wpcf7beforesubmit (high priority)
  document.addEventListener("wpcf7beforesubmit", function(e) {
    const $form = $(e.target);
    if (!$form.hasClass('venue_for_hire')) return; // Only for venue forms
    
    if (!validateVenueForm($form)) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }
  }, true);
  
  // Method 2: Regular form submit event (backup)
  $(document).on('submit', '.venue_for_hire', function(e) {
    const $form = $(this);
    if (!validateVenueForm($form)) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }
  });
  
  // Method 3: CF7 invalid event (when CF7 detects invalid fields)
  document.addEventListener('wpcf7invalid', function(e) {
    const $form = $(e.target);
    if ($form.hasClass('venue_for_hire')) {
      validateVenueForm($form); // Re-run our validation to show our custom errors
    }
  });
  
  // Method 4: Intercept submit button clicks
  $(document).on('click', '.venue_for_hire input[type="submit"], .venue_for_hire button[type="submit"]', function(e) {
    const $form = $(this).closest('.wpcf7-form');
    if (!validateVenueForm($form)) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }
  });
});
</script>

<script>
// Solution 1: Combined approach with validation
document.addEventListener('DOMContentLoaded', function() {
    var today = new Date();
    var todayString = today.toISOString().split('T')[0];
    
    document.querySelectorAll('.wpcf7-date').forEach(function(field) {
        // Set min attribute (works on most browsers)
        field.setAttribute('min', todayString);
        
        // Add change event listener for iOS compatibility
        field.addEventListener('change', function(e) {
            var selectedDate = new Date(e.target.value);
            var currentDate = new Date();
            currentDate.setHours(0, 0, 0, 0); // Reset time for accurate comparison
            
            if (selectedDate < currentDate) {
                alert('Please select a date from today onwards.');
                e.target.value = todayString; // Reset to today's date
            }
        });
        
        // Additional input event for real-time validation
        field.addEventListener('input', function(e) {
            var selectedDate = new Date(e.target.value);
            var currentDate = new Date();
            currentDate.setHours(0, 0, 0, 0);
            
            if (selectedDate < currentDate) {
                e.target.setCustomValidity('Please select a date from today onwards.');
            } else {
                e.target.setCustomValidity('');
            }
        });
    });
});
</script>

<script>
jQuery(function($) {
  // ========== COMMON ERROR HANDLING FUNCTIONS ==========
  function addCF7Error($input, message) {
    $input.addClass("wpcf7-not-valid");
    var $tip = $input.siblings(".wpcf7-not-valid-tip");
    if (!$tip.length) {
      $tip = $('<span class="wpcf7-not-valid-tip" role="alert"></span>');
      $input.after($tip);
    }
    $tip.text(message).show();
  }
  
  function removeCF7Error($input) {
    $input.removeClass("wpcf7-not-valid");
    $input.siblings(".wpcf7-not-valid-tip").hide().text("");
  }
  
  // ========== VENUE FORM VALIDATION (Saturday/Sunday Only) ==========
  function validateVenueForm($form) {
    let isValid = true;
    const $dateField = $form.find("input[name='date-259']");
    
    if ($dateField.length) {
      if ($dateField.val()) {
        let d = new Date($dateField.val());
        let day = d.getDay();
        if (day !== 0 && day !== 6) {
          addCF7Error($dateField, "Please select Saturday or Sunday only.");
          isValid = false;
        } else {
          removeCF7Error($dateField);
        }
      } else {
        addCF7Error($dateField, "Please select a date.");
        isValid = false;
      }
    }
    return isValid;
  }
  
  // ========== EVENT TIME VALIDATION (12PM-3PM & 5PM-10PM, 30min intervals) ==========
  function validateEventTime($timeField) {
    let isValid = true;
    
    if ($timeField.val()) {
      let raw = $timeField.val().trim();
      let hour, minute;
      
      // Parse different time formats
      if (/^\d{2}:\d{2}$/.test(raw)) {
        let parts = raw.split(":");
        hour = parseInt(parts[0], 10);
        minute = parseInt(parts[1], 10);
      } else if (/^\d{1,2}:\d{2}\s?(AM|PM)$/i.test(raw)) {
        let parts = raw.match(/^(\d{1,2}):(\d{2})\s?(AM|PM)$/i);
        hour = parseInt(parts[1], 10);
        minute = parseInt(parts[2], 10);
        let ampm = parts[3].toUpperCase();
        if (ampm === "PM" && hour < 12) hour += 12;
        if (ampm === "AM" && hour === 12) hour = 0;
      }
      
      // Validate time ranges: 12:00 PM to 3:00 PM AND 5:00 PM to 10:00 PM
      const isInFirstRange = (hour >= 12 && hour < 15) || (hour === 15 && minute === 0);
      const isInSecondRange = (hour >= 17 && hour < 22) || (hour === 22 && minute === 0);
      const isValidInterval = minute === 0 || minute === 30;
      
      if (!isInFirstRange && !isInSecondRange) {
        addCF7Error($timeField, "Time must be between 12:00 PM - 3:00 PM or 5:00 PM - 10:00 PM.");
        isValid = false;
      } else if (!isValidInterval) {
        addCF7Error($timeField, "Time must be on 30-minute intervals (12:00, 12:30, 1:00, etc.).");
        isValid = false;
      } else {
        removeCF7Error($timeField);
      }
    } else {
      addCF7Error($timeField, "Please select a time.");
      isValid = false;
    }
    
    return isValid;
  }
  
  // ========== OFFICE CATERING TIME VALIDATION (11AM-10PM, 30min intervals) ==========
  function validateOfficeCateringTime($timeField) {
    let isValid = true;
    
    if ($timeField.val()) {
      let raw = $timeField.val().trim();
      let hour, minute;
      
      // Parse different time formats
      if (/^\d{2}:\d{2}$/.test(raw)) {
        let parts = raw.split(":");
        hour = parseInt(parts[0], 10);
        minute = parseInt(parts[1], 10);
      } else if (/^\d{1,2}:\d{2}\s?(AM|PM)$/i.test(raw)) {
        let parts = raw.match(/^(\d{1,2}):(\d{2})\s?(AM|PM)$/i);
        hour = parseInt(parts[1], 10);
        minute = parseInt(parts[2], 10);
        let ampm = parts[3].toUpperCase();
        if (ampm === "PM" && hour < 12) hour += 12;
        if (ampm === "AM" && hour === 12) hour = 0;
      }
      
      // Validate time range: 11:00 AM to 10:00 PM with 30-minute intervals
      const isInTimeRange = (hour >= 11 && hour < 22) || (hour === 22 && minute === 0);
      const isValidInterval = minute === 0 || minute === 30;
      
      if (!isInTimeRange) {
        addCF7Error($timeField, "Time must be between 11:00 AM and 10:00 PM.");
        isValid = false;
      } else if (!isValidInterval) {
        addCF7Error($timeField, "Time must be on 30-minute intervals (11:00, 11:30, 12:00, etc.).");
        isValid = false;
      } else {
        removeCF7Error($timeField);
      }
    } else {
      addCF7Error($timeField, "Please select a time.");
      isValid = false;
    }
    
    return isValid;
  }
  
  // ========== DATE VALIDATION (Tomorrow onwards) ==========
  function getTomorrowDate() {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    return tomorrow.toISOString().split('T')[0];
  }
  
  function validateDateField($dateField) {
    let isValid = true;
    const selectedDate = $dateField.val();
    const tomorrowDate = getTomorrowDate();
    
    if (selectedDate) {
      if (selectedDate < tomorrowDate) {
        addCF7Error($dateField, "Please select a date from tomorrow onwards.");
        isValid = false;
      } else {
        removeCF7Error($dateField);
      }
    } else {
      addCF7Error($dateField, "Please select a date.");
      isValid = false;
    }
    
    return isValid;
  }
  
  function updateMinDate($dateField) {
    const tomorrowDate = getTomorrowDate();
    $dateField.attr('min', tomorrowDate);
  }
  
  // ========== TIME PICKER RESTRICTIONS ==========
  // Event time picker (12PM-3PM & 5PM-10PM, 30min intervals)
  function restrictEventTimePicker() {
    setTimeout(function() {
      const $timePicker = $('.xdsoft_datetimepicker .xdsoft_time_variant');
      if ($timePicker.length) {
        $timePicker.css("margin", "-1px 0px 0px");
        $timePicker.find('.xdsoft_time').each(function() {
          const $timeSlot = $(this);
          const hour = parseInt($timeSlot.attr('data-hour'), 10);
          const minute = parseInt($timeSlot.attr('data-minute'), 10);
          
          const isInFirstRange = (hour >= 12 && hour < 15) || (hour === 15 && minute === 0);
          const isInSecondRange = (hour >= 17 && hour < 22) || (hour === 22 && minute === 0);
          const isValidInterval = minute === 0 || minute === 30;
          
          if ((!isInFirstRange && !isInSecondRange) || !isValidInterval) {
            $timeSlot.hide().addClass('xdsoft_disabled');
          } else {
            $timeSlot.show().removeClass('xdsoft_disabled');
          }
        });
      }
    }, 100);
  }
  
  // Office catering time picker (11AM-10PM, 30min intervals)
  function restrictOfficeCateringTimePicker() {
    setTimeout(function() {
      const $timePicker = $('.xdsoft_datetimepicker .xdsoft_time_variant');
      if ($timePicker.length) {
        $timePicker.css("margin", "-1px 0px 0px");
        $timePicker.find('.xdsoft_time').each(function() {
          const $timeSlot = $(this);
          const hour = parseInt($timeSlot.attr('data-hour'), 10);
          const minute = parseInt($timeSlot.attr('data-minute'), 10);
          
          const isInTimeRange = (hour >= 11 && hour < 22) || (hour === 22 && minute === 0);
          const isValidInterval = minute === 0 || minute === 30;
          
          if (!isInTimeRange || !isValidInterval) {
            $timeSlot.hide().addClass('xdsoft_disabled');
          } else {
            $timeSlot.show().removeClass('xdsoft_disabled');
          }
        });
      }
    }, 100);
  }
  
  // ========== FIELD SELECTORS ==========
  const venueFormSelector = '.venue_for_hire';
  const venueDateSelector = "input[name='date-259']";
  const eventTimeSelector = 'input[name="Eventtime"]';
  const officeCateringSelector = 'input[name="officecateringtime"]';
  const dateSelector = 'input[name="date-2612"]';
  
  // ========== INITIALIZATION ==========
  $(document).ready(function() {
    // Set minimum date for office catering date field
    const $dateField = $(dateSelector);
    if ($dateField.length) {
      updateMinDate($dateField);
    }
    
    // Set minimum date for all general date fields
    document.querySelectorAll('.wpcf7-date').forEach(function(field) {
      var today = new Date().toISOString().split('T')[0];
      field.setAttribute('min', today);
      
      // iOS compatibility
      field.addEventListener('change', function(e) {
        var selectedDate = new Date(e.target.value);
        var currentDate = new Date();
        currentDate.setHours(0, 0, 0, 0);
        
        if (selectedDate < currentDate) {
          alert('Please select a date from today onwards.');
          e.target.value = today;
        }
      });
      
      field.addEventListener('input', function(e) {
        var selectedDate = new Date(e.target.value);
        var currentDate = new Date();
        currentDate.setHours(0, 0, 0, 0);
        
        if (selectedDate < currentDate) {
          e.target.setCustomValidity('Please select a date from today onwards.');
        } else {
          e.target.setCustomValidity('');
        }
      });
    });
  });
  
  // Update min date hourly
  setInterval(function() {
    const $dateField = $(dateSelector);
    if ($dateField.length) {
      updateMinDate($dateField);
    }
  }, 60000 * 60);
  
  // ========== EVENT LISTENERS ==========
  // Venue form validation (Saturday/Sunday only)
  $(document).on("change blur", venueFormSelector + " " + venueDateSelector, function() {
    const $form = $(this).closest(".wpcf7-form");
    validateVenueForm($form);
  });
  
  // Event time validation
  $(document).on("change blur", eventTimeSelector, function() {
    validateEventTime($(this));
  });
  
  // Office catering time validation
  $(document).on("change blur", officeCateringSelector, function() {
    validateOfficeCateringTime($(this));
  });
  
  // Office catering date validation
  $(document).on("change blur", dateSelector, function() {
    validateDateField($(this));
  });
  
  // Time picker restrictions
  $(document).on('click focus', eventTimeSelector, function() {
    restrictEventTimePicker();
    setTimeout(restrictEventTimePicker, 200);
    setTimeout(restrictEventTimePicker, 500);
  });
  
  $(document).on('click focus', officeCateringSelector, function() {
    restrictOfficeCateringTimePicker();
    setTimeout(restrictOfficeCateringTimePicker, 200);
    setTimeout(restrictOfficeCateringTimePicker, 500);
  });
  
  // ========== FORM SUBMISSION PREVENTION ==========
  // Primary prevention - wpcf7beforesubmit
  document.addEventListener("wpcf7beforesubmit", function(e) {
    const $form = $(e.target);
    let isFormValid = true;
    
    // Venue form validation
    if ($form.hasClass('venue_for_hire')) {
      if (!validateVenueForm($form)) {
        isFormValid = false;
      }
    }
    
    // Event time validation
    const $eventTimeField = $form.find(eventTimeSelector);
    if ($eventTimeField.length && !validateEventTime($eventTimeField)) {
      isFormValid = false;
    }
    
    // Office catering validation
    const $officeCateringTimeField = $form.find(officeCateringSelector);
    const $officeCateringDateField = $form.find(dateSelector);
    
    if ($officeCateringTimeField.length && !validateOfficeCateringTime($officeCateringTimeField)) {
      isFormValid = false;
    }
    
    if ($officeCateringDateField.length && !validateDateField($officeCateringDateField)) {
      isFormValid = false;
    }
    
    if (!isFormValid) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }
  }, true);
  
  // Backup prevention - form submit
  $(document).on('submit', 'form', function(e) {
    const $form = $(this);
    let isFormValid = true;
    
    // Venue form validation
    if ($form.hasClass('venue_for_hire')) {
      if (!validateVenueForm($form)) {
        isFormValid = false;
      }
    }
    
    // Event time validation
    const $eventTimeField = $form.find(eventTimeSelector);
    if ($eventTimeField.length && !validateEventTime($eventTimeField)) {
      isFormValid = false;
    }
    
    // Office catering validation
    const $officeCateringTimeField = $form.find(officeCateringSelector);
    const $officeCateringDateField = $form.find(dateSelector);
    
    if ($officeCateringTimeField.length && !validateOfficeCateringTime($officeCateringTimeField)) {
      isFormValid = false;
    }
    
    if ($officeCateringDateField.length && !validateDateField($officeCateringDateField)) {
      isFormValid = false;
    }
    
    if (!isFormValid) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }
  });
  
  // Additional venue form specific handlers
  document.addEventListener('wpcf7invalid', function(e) {
    const $form = $(e.target);
    if ($form.hasClass('venue_for_hire')) {
      validateVenueForm($form);
    }
  });
  
  $(document).on('click', '.venue_for_hire input[type="submit"], .venue_for_hire button[type="submit"]', function(e) {
    const $form = $(this).closest('.wpcf7-form');
    if (!validateVenueForm($form)) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }
  });
  
  // ========== DYNAMIC CONTENT HANDLING ==========
  const observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      if (mutation.addedNodes.length) {
        // Handle dynamically added time pickers
        $(mutation.addedNodes).find('.xdsoft_datetimepicker').each(function() {
          // Check which time field is active and apply appropriate restrictions
          if ($(eventTimeSelector).is(':focus')) {
            restrictEventTimePicker();
          }
          if ($(officeCateringSelector).is(':focus')) {
            restrictOfficeCateringTimePicker();
          }
        });
        
        // Handle dynamically added date fields
        $(mutation.addedNodes).find(dateSelector).each(function() {
          updateMinDate($(this));
        });
        
        // Handle dynamically added general date fields
        $(mutation.addedNodes).find('.wpcf7-date').each(function() {
          var today = new Date().toISOString().split('T')[0];
          this.setAttribute('min', today);
        });
      }
    });
  });
  
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
});
</script>

<script>
jQuery(function($) {
  function addCF7Error($input, message) {
    $input.addClass("wpcf7-not-valid");
    var $tip = $input.siblings(".wpcf7-not-valid-tip");
    if (!$tip.length) {
      $tip = $('<span class="wpcf7-not-valid-tip" role="alert"></span>');
      $input.after($tip);
    }
    $tip.text(message).show();
  }
  
  function removeCF7Error($input) {
    $input.removeClass("wpcf7-not-valid");
    $input.siblings(".wpcf7-not-valid-tip").hide().text("");
  }
  
  // ========== TIME VALIDATION ==========
  function validateOfficeCateringTime($timeField) {
    let isValid = true;
    
    if ($timeField.val()) {
      let raw = $timeField.val().trim();
      let hour, minute;
      
      // Parse different time formats
      if (/^\d{2}:\d{2}$/.test(raw)) {
        // 24-hour format (14:30)
        let parts = raw.split(":");
        hour = parseInt(parts[0], 10);
        minute = parseInt(parts[1], 10);
      } else if (/^\d{1,2}:\d{2}\s?(AM|PM)$/i.test(raw)) {
        // 12-hour format with AM/PM
        let parts = raw.match(/^(\d{1,2}):(\d{2})\s?(AM|PM)$/i);
        hour = parseInt(parts[1], 10);
        minute = parseInt(parts[2], 10);
        let ampm = parts[3].toUpperCase();
        if (ampm === "PM" && hour < 12) hour += 12;
        if (ampm === "AM" && hour === 12) hour = 0;
      }
      
      // Validate time range: 11:00 AM to 10:00 PM (11:00-22:00) with 30-minute intervals
      const isInTimeRange = (hour >= 11 && hour < 22) || (hour === 22 && minute === 0);
      const isValidInterval = minute === 0 || minute === 30;
      
      if (!isInTimeRange) {
        addCF7Error($timeField, "Time must be between 11:00 AM and 10:00 PM.");
        isValid = false;
      } else if (!isValidInterval) {
        addCF7Error($timeField, "Time must be on 30-minute intervals (11:00, 11:30, 12:00, etc.).");
        isValid = false;
      } else {
        removeCF7Error($timeField);
      }
    } else {
      addCF7Error($timeField, "Please select a time.");
      isValid = false;
    }
    
    return isValid;
  }
  
  // Restrict time picker options to 11:00 AM - 10:00 PM with 30-minute intervals
  function restrictTimePicker() {
    setTimeout(function() {
      const $timePicker = $('.xdsoft_datetimepicker .xdsoft_time_variant');
      if ($timePicker.length) {
        $timePicker.css("margin", "-1px 0px 0px");

        $timePicker.find('.xdsoft_time').each(function() {
          const $timeSlot = $(this);
          const hour = parseInt($timeSlot.attr('data-hour'), 10);
          const minute = parseInt($timeSlot.attr('data-minute'), 10);
          
          // Show times from 11:00-22:00 (11:00 AM - 10:00 PM) with 30-minute intervals
          const isInTimeRange = (hour >= 11 && hour < 22) || (hour === 22 && minute === 0);
          const isValidInterval = minute === 0 || minute === 30;
          
          if (!isInTimeRange || !isValidInterval) {
            $timeSlot.hide().addClass('xdsoft_disabled');
          } else {
            $timeSlot.show().removeClass('xdsoft_disabled');
          }
        });
      }
    }, 100);
  }
  
  // ========== DATE VALIDATION ==========
  function getTomorrowDate() {
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    return tomorrow.toISOString().split('T')[0]; // Format: YYYY-MM-DD
  }
  
  function validateDateField($dateField) {
    let isValid = true;
    const selectedDate = $dateField.val();
    const tomorrowDate = getTomorrowDate();
    
    if (selectedDate) {
      if (selectedDate < tomorrowDate) {
        addCF7Error($dateField, "Please select a date from tomorrow onwards.");
        isValid = false;
      } else {
        removeCF7Error($dateField);
      }
    } else {
      addCF7Error($dateField, "Please select a date.");
      isValid = false;
    }
    
    return isValid;
  }
  
  function updateMinDate($dateField) {
    const tomorrowDate = getTomorrowDate();
    $dateField.attr('min', tomorrowDate);
  }
  
  // ========== FIELD SELECTORS ==========
  const officeCateringSelector = 'input[name="officecateringtime"]';
  const dateSelector = 'input[name="date-2612"]';
  
  // ========== INITIALIZATION ==========
  $(document).ready(function() {
    // Set minimum date to tomorrow on page load
    const $dateField = $(dateSelector);
    if ($dateField.length) {
      updateMinDate($dateField);
    }
  });
  
  // Update min date daily (in case page stays open overnight)
  setInterval(function() {
    const $dateField = $(dateSelector);
    if ($dateField.length) {
      updateMinDate($dateField);
    }
  }, 60000 * 60); // Check every hour
  
  // ========== TIME FIELD EVENTS ==========
  // Validate time on change and blur events
  $(document).on("change blur", officeCateringSelector, function() {
    validateOfficeCateringTime($(this));
  });
  
  // Apply time picker restrictions when the office catering time field is clicked/focused
  $(document).on('click focus', officeCateringSelector, function() {
    restrictTimePicker();
    setTimeout(restrictTimePicker, 200);
    setTimeout(restrictTimePicker, 500);
  });
  
  // ========== DATE FIELD EVENTS ==========
  // Validate date on change and blur events
  $(document).on("change blur", dateSelector, function() {
    validateDateField($(this));
  });
  
  // ========== FORM SUBMISSION PREVENTION ==========
  // Prevent form submission if validation fails
  document.addEventListener("wpcf7beforesubmit", function(e) {
    const $form = $(e.target);
    const $timeField = $form.find(officeCateringSelector);
    const $dateField = $form.find(dateSelector);
    
    let isFormValid = true;
    
    // Validate time field
    if ($timeField.length && !validateOfficeCateringTime($timeField)) {
      isFormValid = false;
    }
    
    // Validate date field
    if ($dateField.length && !validateDateField($dateField)) {
      isFormValid = false;
    }
    
    if (!isFormValid) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }
  }, true);
  
  // Backup form submit prevention
  $(document).on('submit', 'form', function(e) {
    const $form = $(this);
    const $timeField = $form.find(officeCateringSelector);
    const $dateField = $form.find(dateSelector);
    
    let isFormValid = true;
    
    // Validate time field
    if ($timeField.length && !validateOfficeCateringTime($timeField)) {
      isFormValid = false;
    }
    
    // Validate date field
    if ($dateField.length && !validateDateField($dateField)) {
      isFormValid = false;
    }
    
    if (!isFormValid) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      return false;
    }
  });
  
  // ========== DYNAMIC CONTENT HANDLING ==========
  // Monitor for dynamically added form elements
  const observer = new MutationObserver(function(mutations) {
    mutations.forEach(function(mutation) {
      if (mutation.addedNodes.length) {
        // Handle dynamically added time pickers
        $(mutation.addedNodes).find('.xdsoft_datetimepicker').each(function() {
          restrictTimePicker();
        });
        
        // Handle dynamically added date fields
        $(mutation.addedNodes).find(dateSelector).each(function() {
          updateMinDate($(this));
        });
      }
    });
  });
  
  observer.observe(document.body, {
    childList: true,
    subtree: true
  });
});
</script>		<!-- Click to Chat - https://holithemes.com/plugins/click-to-chat/  v4.39 -->
