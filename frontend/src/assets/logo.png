<!-- FAQ Schema -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where is The Grand Palace Indian Restaurant located?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We are located at Basement, 261 George Street, Sydney NSW 2000, Australia."
      }
    },
    {
      "@type": "Question",
      "name": "What are your opening hours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Lunch: Monday to Friday 12:00pm – 3:00pm. Dinner: Sunday–Thursday 5:00pm – 10:00pm and Friday–Saturday 5:00pm – 10:30pm."
      }
    },
    {
      "@type": "Question",
      "name": "How can I make a reservation?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can book a table online via our website or by calling us on +61 2 8021 7696."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer vegetarian and vegan dishes?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we offer several vegetarian and vegan dishes that showcase authentic Indian flavours."
      }
    },
    {
      "@type": "Question",
      "name": "Do you provide gluten-free or halal options?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we have gluten-free and halal-friendly options available. Our staff will be happy to assist with dietary needs."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer takeaway and delivery?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, takeaway and delivery are available through our website and select delivery partners."
      }
    },
    {
      "@type": "Question",
      "name": "Do you cater for corporate or private events?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we provide catering for corporate events, celebrations, and private functions both at our venue and off-site."
      }
    },
    {
      "@type": "Question",
      "name": "Is parking available nearby?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Paid parking options are available within short walking distance, and public transport access is very convenient."
      }
    },
    {
      "@type": "Question",
      "name": "Do you serve alcohol at the restaurant?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, we offer a wide selection of wines, cocktails and beverages to complement your meal."
      }
    },
    {
      "@type": "Question",
      "name": "Is your restaurant kid-friendly?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, families with children are welcome. We have several mild dishes suitable for younger guests."
      }
    }
  ]
}
</script>
<!-- End FAQs Schema -->

